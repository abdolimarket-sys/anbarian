    "vite": "^5.4.10",
    "@capacitor/cli": "^6.2.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/camera": "^6.0.2",
    "@capacitor/app": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2"
  }
}
